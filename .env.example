# Koneksi database PostgreSQL (Neon/Supabase/Railway). Wajib.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Kode undangan pendaftaran.
# - Diisi  -> hanya yang punya kode bisa mendaftar.
# - Kosong -> pendaftaran DITUTUP untuk semua orang.
# Ganti kapan saja lalu redeploy. Jangan dibagikan di tempat umum.
SIGNUP_CODE="ganti-dengan-kode-rahasia"

# Secret untuk autentikasi Cron Vercel (pembersihan Story kedaluwarsa harian).
# Buat nilai acak dengan: openssl rand -hex 32
CRON_SECRET="ganti-dengan-secret-acak"

# Email untuk lupa kata sandi (Resend). Verifikasi domain pengirim di Resend.
RESEND_API_KEY=""
PASSWORD_RESET_FROM="HeyTalent <no-reply@domainmu.com>"
# URL utama aplikasi; tautan reset dikirim ke alamat ini.
APP_URL="https://domain-aplikasimu.com"
